{
  "private": true,
  "name": "congratis-web",
  "version": "0.1.0",
  "scripts": {
    "build": "rimraf dist/js && rollup --bundleConfigAsCjs --config",
    "watch": "rimraf dist/js && rollup --bundleConfigAsCjs --config --watch",
    "finalize:assets": "node scripts/finalize-assets.mjs",
    "test:e2e": "playwright test",
    "prepare:e2e": "cp index.html dist/index.html && cp style.css dist/style.css && cp ../frontend/christmas-tree.webp dist/christmas-tree.webp && cp ../frontend/no-invitation.webp dist/no-invitation.webp && npm run finalize:assets"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@wasm-tool/rollup-plugin-rust": "3.1.6",
    "rimraf": "^5.0.0",
    "rollup": "^3.21.0",
    "rollup-plugin-livereload": "^2.0.0",
    "rollup-plugin-serve": "^2.0.0",
    "binaryen": "132.0.0"
  }
}
