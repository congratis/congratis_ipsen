# RethinkDB connection (inside Docker the app uses service name "rethinkdb")
RETHINKDB_HOST=127.0.0.1
RETHINKDB_PORT=28015
RETHINKDB_USER=admin
RETHINKDB_PASSWORD=replace-with-a-long-random-secret
RETHINKDB_DB=congratis

# Public hostname and Let's Encrypt registration email
DOMAIN=your-domain.example
LETSENCRYPT_EMAIL=admin@your-domain.example

HOST=0.0.0.0
PORT=8080
RUST_LOG=info
PUBLIC_BASE_URL=https://your-domain.example
