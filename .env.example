# RethinkDB connection (Docker Compose service DNS)
RETHINKDB_HOST=rethinkdb
RETHINKDB_PORT=28015
RETHINKDB_USER=admin
# Replace with a long random secret; never commit the real .env file.
RETHINKDB_PASSWORD=replace-with-a-long-random-secret
RETHINKDB_DB=congratis

# Public hostname
DOMAIN=congratis.online
# Local development uses plain HTTP. Set TLS_MODE=globalsign on production.
TLS_MODE=http

HOST=0.0.0.0
PORT=8080
RUST_LOG=info
PUBLIC_BASE_URL=http://localhost

# Admin credentials: generate a hash with
# docker compose run --rm -e ADMIN_PASSWORD='a-long-random-password' app hash-admin-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-argon2id-hash
# Set false only for local HTTP development; production must use true.
COOKIE_SECURE=false
