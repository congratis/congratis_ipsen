# SSH target and dedicated administrative account (never root).
SSH_HOST=your-vps-hostname
SSH_PORT=22
SSH_USER=congratis-ops
SSH_IDENTITY_FILE=/run/secrets/congratis_ssh_key
SSH_KNOWN_HOSTS_FILE=/etc/congratis-mcp/known_hosts

# Every exec command is run through: sudo -n -- /bin/bash -lc <command>
SSH_SUDO=true
# Default per-call timeout; MCP clients may override with timeout_ms.
SSH_COMMAND_TIMEOUT_MS=30000
SSH_MAX_COMMAND_BYTES=32768
SSH_MAX_OUTPUT_BYTES=262144
