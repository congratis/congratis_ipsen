map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

map $uri $congratis_cache_control {
    default "no-store";
    ~*\.(?:css|js)$ "public, max-age=31536000, immutable";
    ~^/avatars/[a-f0-9]+\.png$ "public, max-age=31536000, immutable";
}

limit_req_zone $binary_remote_addr zone=congratis_auth:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=congratis_admin_login:10m rate=5r/m;

upstream congratis_app {
    server app:8080;
    keepalive 16;
}

server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN};

    client_max_body_size 2m;
    add_header Cache-Control $congratis_cache_control always;

    location = /api/presence {
        proxy_pass http://congratis_app/api/presence;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location = /api/events {
        proxy_pass http://congratis_app/api/events;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location = /api/auth/admin/login {
        limit_req zone=congratis_admin_login burst=5 nodelay;
        proxy_pass http://congratis_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /api/auth/ {
        limit_req zone=congratis_auth burst=10 nodelay;
        proxy_pass http://congratis_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://congratis_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://congratis_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
